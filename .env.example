# Ambiente do Brawl Hub
# Copie este arquivo para `.env` e preencha os valores.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-segura
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API oficial da Supercell (entra em uso na Fase 4)
# Nunca commite a chave real. Este arquivo .env.example não deve contê-la.
SUPERCELL_API_KEY=
SUPERCELL_API_BASE=https://api.brawlstars.com/v1
SUPERCELL_REQUEST_TIMEOUT=10
